# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 공개 저장소에 올리지 마세요)
SECRET_KEY=change-me-to-a-long-random-string

# 인증번호 메일 발송 (SMTP). 비워두면 로컬에서는 인증번호를 화면에 보여줍니다.
# Gmail 예시: Google 계정 → 보안 → 2단계 인증 켜기 → "앱 비밀번호" 만들기 (16자리)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=보내는주소@gmail.com
#   SMTP_PASSWORD=앱비밀번호16자리
# 네이버 예시: 네이버 메일 → 환경설정 → POP3/IMAP 설정 → SMTP 사용함
#   SMTP_HOST=smtp.naver.com
#   SMTP_PORT=587
#   SMTP_USER=네이버아이디@naver.com
#   SMTP_PASSWORD=네이버 비밀번호 (2단계 인증 사용 시 애플리케이션 비밀번호)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 포인트 / 인기글 설정 (선택)
# POINTS_POST=200
# POINTS_COMMENT=50
# DAILY_COMMENT_POINT_LIMIT=0   # 하루 댓글 포인트 지급 횟수 제한 (0=무제한)
# POPULAR_MIN_UPVOTES=3
