# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 공개 저장소에 올리지 마세요)
SECRET_KEY=change-me-to-a-long-random-string

# 개발용 로그인 버튼 (소셜 키 없이 테스트). 운영에서는 0
DEV_LOGIN=1

# 구글: https://console.cloud.google.com/apis/credentials
#   승인된 리디렉션 URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 네이버: https://developers.naver.com/apps  (사용 API: 네이버 로그인)
#   Callback URL: http://localhost:5000/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 페이스북: https://developers.facebook.com/apps  (Facebook 로그인 제품 추가)
#   유효한 OAuth 리디렉션 URI: http://localhost:5000/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# 포인트 / 인기글 설정 (선택)
# POINTS_POST=200
# POINTS_COMMENT=50
# DAILY_COMMENT_POINT_LIMIT=0   # 하루 댓글 포인트 지급 횟수 제한 (0=무제한)
# POPULAR_MIN_UPVOTES=3
